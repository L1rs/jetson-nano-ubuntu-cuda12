+/* T210_MAINLINE: GPU-Strom ueber DT (vdd-supply, Takte gpu/ref/pwr, Reset, PMC-Clamp) wie nouveau */
+#include <linux/regulator/consumer.h>
+#include <soc/tegra/pmc.h>
+static struct regulator *t210_vdd;
+int t210_gpu_mhz = 640;	/* initial / current gpcclk target, MHz (<= 640) */
+
+/* VDD_GPU for gpcclk, from L4T 4.9 /sys/kernel/debug/tegra_dvfs/gpu_dvfs_t (this chip, row 15..30 C).
+ * ponytail: static, one temperature row; below 15 C L4T wants 958 mV, add a temp lookup if cold boots matter. */
+void t210_gpu_vdd_set(unsigned long hz)
+{
+	static const struct { unsigned int khz, mv; } tbl[] = {
+		{ 460800, 818 }, { 537600, 848 }, { 614400, 888 }, { 691200, 928 },
+	};
+	unsigned int i, mv = 928;
+
+	if (IS_ERR_OR_NULL(t210_vdd))
+		return;
+	for (i = 0; i < ARRAY_SIZE(tbl); i++)
+		if (hz / 1000 <= tbl[i].khz) { mv = tbl[i].mv; break; }
+	if (regulator_set_voltage(t210_vdd, mv * 1000, mv * 1000 + 20000))
+		pr_warn("nvgpu: set vdd-gpu %u mV failed\n", mv);
+	else
+		pr_info("nvgpu: vdd-gpu %u mV for %lu kHz (read back %d uV)\n", mv, hz / 1000, regulator_get_voltage(t210_vdd));
+}
+
+static int t210_gpu_mhz_set(const char *val, const struct kernel_param *kp)
+{
+	int mhz, ret = kstrtoint(val, 0, &mhz);
+
+	if (ret)
+		return ret;
+	if (mhz < 77 || mhz > 640)
+		return -EINVAL;
+	t210_gpu_mhz = mhz;
+	if (t210_g && t210_g->clk.tegra_clk)
+		return clk_set_rate(t210_g->clk.tegra_clk, mhz * 1000000UL);
+	return 0;
+}
+static int t210_gpu_mhz_get(char *buf, const struct kernel_param *kp)
+{
+	return sprintf(buf, "%lu\n", t210_g && t210_g->clk.tegra_clk ?
+		       clk_get_rate(t210_g->clk.tegra_clk) / 1000000 : (unsigned long)t210_gpu_mhz);
+}
+static const struct kernel_param_ops t210_gpu_mhz_ops = { .set = t210_gpu_mhz_set, .get = t210_gpu_mhz_get };
+module_param_cb(t210_gpu_mhz, &t210_gpu_mhz_ops, NULL, 0644);
+static struct clk *t210_clk_gpu;
+static int t210_mainline_power_up(struct device *dev)
+{
+	struct gk20a_platform *platform = dev_get_drvdata(dev);
+	int ret;
+
+	t210_vdd = devm_regulator_get(dev, "vdd");
+	if (IS_ERR(t210_vdd))
+		return PTR_ERR(t210_vdd);
+	t210_clk_gpu = devm_clk_get(dev, "gpu");
+	if (IS_ERR(t210_clk_gpu))
+		return PTR_ERR(t210_clk_gpu);
+	platform->clk[0] = devm_clk_get(dev, "ref");
+	if (IS_ERR(platform->clk[0]))
+		return PTR_ERR(platform->clk[0]);
+	platform->clk[1] = devm_clk_get(dev, "pwr");
+	if (IS_ERR(platform->clk[1]))
+		return PTR_ERR(platform->clk[1]);
+	platform->clk[2] = NULL;
+	platform->clk[3] = NULL;
+	platform->num_clks = 2;
+
+	if (!platform->reset_control) {
+		platform->reset_control = devm_reset_control_get(dev, "gpu");
+		if (IS_ERR(platform->reset_control))
+			return PTR_ERR(platform->reset_control);
+	}
+	ret = regulator_set_voltage(t210_vdd, 1000000, 1000000);
+	if (ret)
+		dev_warn(dev, "set vdd 1.0V failed: %d\n", ret);
+	ret = regulator_enable(t210_vdd);
+	if (ret)
+		return ret;
+	clk_set_rate(platform->clk[1], 204000000);
+	ret = clk_prepare_enable(t210_clk_gpu) ?:
+	      clk_prepare_enable(platform->clk[0]) ?:
+	      clk_prepare_enable(platform->clk[1]);
+	if (ret)
+		return ret;
+	udelay(10);
+	if (platform->reset_control)
+		reset_control_assert(platform->reset_control);
+	udelay(10);
+	ret = tegra_powergate_remove_clamping(TEGRA_POWERGATE_3D);
+	if (ret)
+		dev_warn(dev, "remove clamping failed: %d\n", ret);
+	udelay(10);
+	if (platform->reset_control)
+		reset_control_deassert(platform->reset_control);
+	udelay(10);
+	dev_info(dev, "T210 mainline: GPU powered up (vdd %d uV, ref %lu Hz)\n",
+		 regulator_get_voltage(t210_vdd), clk_get_rate(platform->clk[0]));
+	return 0;
+}
